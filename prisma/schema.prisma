generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────
// Enums
// ───────────────────────────────────────────

enum Role {
  admin
  manager
  customer
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  TRANSFER
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum UserType {
  admin
  customer
}

enum LoyaltyPointType {
  EARN
  REDEEM
  EXPIRE
  REFUND
}

// ───────────────────────────────────────────
// Tenant & Branch
// ───────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  admins        AdminUser[]
  customers     Customer[]
  products      Product[]
  tags          Tag[]
  suppliers     Supplier[]
  stockMovements StockMovement[]
  orders        Order[]
  categories    Category[]
  coupons       Coupon[]
  shippingRates ShippingRate[]

  @@index([slug])
  @@index([isActive])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  orders         Order[]
  admins         AdminUser[]

  @@index([tenantId])
}

// ───────────────────────────────────────────
// Auth
// ───────────────────────────────────────────

model AdminUser {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?
  email     String
  password  String
  firstName String
  lastName  String
  role      Role     @default(manager)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
}

// ───────────────────────────────────────────
// Customers
// ───────────────────────────────────────────

model Customer {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  password     String
  firstName    String
  lastName     String
  phone        String?
  birthDate    DateTime?
  loyaltyPoints Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses      CustomerAddress[]
  orders         Order[]
  reviews        Review[]
  wishlists      Wishlist[]
  loyaltyPointsRecords LoyaltyPoint[]
  couponUses     CouponUse[]
  abandonedCarts AbandonedCart[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ───────────────────────────────────────────
// Refresh Tokens (Rotation-based)
// ───────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  userType  UserType
  tenantId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  revokedBy String?
  ipAddress String?
  userAgent String?
  familyId  String    @default(uuid())
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId, userType])
  @@index([familyId])
  @@index([tenantId])
  @@index([revokedAt])
}

// ───────────────────────────────────────────
// Customer Address
// ───────────────────────────────────────────

model CustomerAddress {
  id         String  @id @default(uuid())
  customerId String
  label      String
  street     String
  city       String
  province   String
  zipCode    String
  country    String  @default("AR")
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ───────────────────────────────────────────
// Catalog
// ───────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  categoryId  String?
  name        String
  slug        String
  description String?  @db.Text
  sku         String?
  isActive    Boolean  @default(true)
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  basePrice   Decimal  @default(0) @db.Decimal(12, 2)
  invoiceType InvoiceType @default(NONE)
  saleUnit    ProductSaleUnit @default(UNIT)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  weight      Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  trackInventory Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  attributes   ProductAttribute[]
  images       ProductImage[]
  tags         ProductTag[]
  suppliers    ProductSupplier[]
  stockMovements StockMovement[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlists    Wishlist[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, isVisible, isActive])
  @@index([tenantId, isActive])
  @@index([tenantId, isVisible])
  @@index([tenantId, name])
  @@index([tenantId, slug])
  @@index([categoryId, basePrice])
  @@index([categoryId, isFeatured])
  @@index([isActive, stock])
  @@index([tenantId, isFeatured])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  sku        String
  name       String
  price      Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice  Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  isActive   Boolean  @default(true)
  weight     Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes  ProductAttribute[]
  images      ProductImage[]
  stockMovements StockMovement[]
  orderItems  OrderItem[]
  wishlists   Wishlist[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String?
  variantId String?
  key       String
  value     String
  createdAt DateTime @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([key, value])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String?
  variantId String?
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

// ───────────────────────────────────────────
// Tags
// ───────────────────────────────────────────

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductTag[]

  @@index([tenantId])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ───────────────────────────────────────────
// Suppliers
// ───────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductSupplier[]

  @@index([tenantId])
}

model ProductSupplier {
  productId  String
  supplierId String
  costPrice  Decimal? @db.Decimal(12, 2)
  sku        String?
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
}

// ───────────────────────────────────────────
// Inventory (Immutable Ledger)
// ───────────────────────────────────────────

model StockMovement {
  id          String       @id @default(uuid())
  tenantId    String
  branchId    String
  productId   String
  variantId   String?
  type        MovementType
  quantity    Int
  reason      String?
  referenceId String?
  createdAt   DateTime     @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, productId])
  @@index([tenantId, branchId, productId, variantId])
  @@index([tenantId, productId, variantId])
  @@index([tenantId, productId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId, branchId, variantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

// ───────────────────────────────────────────
// Orders
// ───────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  tenantId        String
  branchId        String
  customerId      String?
  guestEmail      String?
  couponId        String?
  couponCode      String?
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(pending)
  paymentId       String?       @unique
  preferenceId    String?
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost    Decimal?      @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  trackingNumber  String?
  shippingMethod  String?
  notes           String?       @db.Text
  shippingAddress Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  couponUses CouponUse[]
  loyaltyPointsRecords LoyaltyPoint[]
  invoices   Invoice[]

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([customerId, createdAt])
  @@index([tenantId, status])
  @@index([guestEmail])
  @@index([paymentId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  name        String
  sku         String?
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  total       Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ───────────────────────────────────────────
// Categories
// ───────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
}

// ───────────────────────────────────────────
// Coupons
// ───────────────────────────────────────────

model Coupon {
  id            String       @id @default(uuid())
  tenantId      String
  code          String
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(12, 2)
  minPurchase   Decimal?     @db.Decimal(12, 2)
  maxDiscount   Decimal?     @db.Decimal(12, 2)
  maxUses       Int?
  usesCount     Int          @default(0)
  perUserLimit  Int          @default(1)
  startsAt      DateTime
  expiresAt     DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  couponUses CouponUse[]
  orders    Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, code])
}

// ───────────────────────────────────────────
// Coupon Use
// ───────────────────────────────────────────

model CouponUse {
  id        String   @id @default(uuid())
  couponId  String
  orderId   String
  customerId String
  usedAt    DateTime @default(now())

  coupon  Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([customerId])
}

// ───────────────────────────────────────────
// Reviews
// ───────────────────────────────────────────

model Review {
  id          String    @id @default(uuid())
  productId   String
  customerId  String
  rating      Int
  title       String?
  comment     String?
  isApproved  Boolean   @default(false)
  approvedAt  DateTime?
  approvedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId])
  @@index([isApproved])
  @@index([productId, isApproved])
}

// ───────────────────────────────────────────
// Loyalty Points
// ───────────────────────────────────────────

model LoyaltyPoint {
  id          String          @id @default(uuid())
  customerId  String
  orderId     String?
  points      Int
  type        LoyaltyPointType
  description String
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([expiresAt])
  @@index([customerId, createdAt])
}

// ───────────────────────────────────────────
// Newsletter
// ───────────────────────────────────────────

model NewsletterSubscriber {
  id            String    @id @default(uuid())
  email         String    @unique
  isActive      Boolean   @default(true)
  subscribedAt  DateTime  @default(now())
  unsubscribedAt DateTime?
  source        String?

  @@index([email])
  @@index([isActive])
}

// ───────────────────────────────────────────
// Shipping Rates
// ───────────────────────────────────────────

model ShippingRate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  minWeight Decimal  @default(0) @db.Decimal(10, 2)
  maxWeight Decimal  @default(99999) @db.Decimal(10, 2)
  price     Decimal  @db.Decimal(10, 2)
  freeFrom  Decimal? @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([tenantId, isActive])
}

// ───────────────────────────────────────────
// Abandoned Carts
// ───────────────────────────────────────────

model AbandonedCart {
  id             String    @id @default(uuid())
  customerId     String?
  email          String?
  cartData       Json
  createdAt      DateTime  @default(now())
  reminderSentAt DateTime?
  recoveredAt    DateTime?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([email])
  @@index([createdAt])
}

// ───────────────────────────────────────────
// Webhook Idempotency
// ───────────────────────────────────────────

model WebhookEvent {
  id        String   @id @default(uuid())
  source    String
  eventId   String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([source, eventId])
}

// ───────────────────────────────────────────
// Invoices
// ───────────────────────────────────────────

enum InvoiceType {
  A
  B
  I
  NONE
}

enum ProductSaleUnit {
  KG
  UNIT
}

model Invoice {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number        String      @unique
  type          InvoiceType
  pdfUrl        String?
  issuedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([orderId])
  @@index([number])
}

// ───────────────────────────────────────────
// Audit Log
// ───────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────────────────────────
// Wishlist
// ───────────────────────────────────────────

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId, variantId])
  @@index([customerId])
  @@index([productId])
  @@index([variantId])
}
