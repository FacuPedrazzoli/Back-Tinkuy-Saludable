generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────
// Enums
// ───────────────────────────────────────────

enum Role {
  admin
  manager
  customer
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  TRANSFER
}

enum OrderStatus {
  pending
  confirmed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  approved
  rejected
}

// ───────────────────────────────────────────
// Tenant & Branch
// ───────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  admins   AdminUser[]
  customers Customer[]
  products  Product[]
  tags      Tag[]
  suppliers Supplier[]
  stockMovements StockMovement[]
  orders    Order[]

  @@index([slug])
  @@index([isActive])
}

model Branch {
  id       String @id @default(uuid())
  tenantId String
  name     String
  address  String?
  phone    String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  orders Order[]
  admins AdminUser[]

  @@index([tenantId])
}

// ───────────────────────────────────────────
// Auth
// ───────────────────────────────────────────

model AdminUser {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?
  email     String
  password  String
  firstName String
  lastName  String
  role      Role     @default(manager)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
}

// ───────────────────────────────────────────
// Customers
// ───────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  password  String
  firstName String
  lastName  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model CustomerAddress {
  id       String @id @default(uuid())
  customerId String
  label    String // e.g. "Casa", "Trabajo"
  street   String
  city     String
  province String
  zipCode  String
  country  String @default("AR")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ───────────────────────────────────────────
// Catalog
// ───────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?  @db.Text
  sku         String?
  isActive    Boolean  @default(true)
  isVisible   Boolean  @default(true)
  basePrice   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  attributes ProductAttribute[]
  images     ProductImage[]
  tags       ProductTag[]
  suppliers  ProductSupplier[]
  stockMovements StockMovement[]
  orderItems OrderItem[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, isVisible, isActive])
  @@index([tenantId, isActive])
  @@index([tenantId, isVisible])
  @@index([tenantId, name])
  @@index([tenantId, slug])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  sku       String
  name      String // e.g. "Chocolate 1kg"
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes ProductAttribute[]
  images     ProductImage[]
  stockMovements StockMovement[]
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String?
  variantId String?
  key       String
  value     String
  createdAt DateTime @default(now())

  product  Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

model ProductImage {
  id        String @id @default(uuid())
  productId String?
  variantId String?
  url       String
  altText   String?
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

// ───────────────────────────────────────────
// Tags
// ───────────────────────────────────────────

model Tag {
  id        String @id @default(uuid())
  tenantId  String
  name      String
  slug      String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    ProductTag[]

  @@index([tenantId])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ───────────────────────────────────────────
// Suppliers
// ───────────────────────────────────────────

model Supplier {
  id        String @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductSupplier[]

  @@index([tenantId])
}

model ProductSupplier {
  productId  String
  supplierId String
  costPrice  Decimal? @db.Decimal(12, 2)
  sku        String?
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
}

// ───────────────────────────────────────────
// Inventory (Immutable Ledger)
// ───────────────────────────────────────────

model StockMovement {
  id          String       @id @default(uuid())
  tenantId    String
  branchId    String
  productId   String
  variantId   String?
  type        MovementType
  quantity    Int // positive for INBOUND, negative for OUTBOUND
  reason      String?
  referenceId String? // orderId or transferId
  createdAt   DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, productId])
  @@index([tenantId, branchId, productId, variantId])
  @@index([tenantId, productId, variantId])
  @@index([tenantId, productId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId, branchId, variantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

// ───────────────────────────────────────────
// Orders
// ───────────────────────────────────────────

model Order {
  id            String        @id @default(uuid())
  tenantId      String
  branchId      String
  customerId    String?
  guestEmail    String?
  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(pending)
  paymentId     String?       @unique // MercadoPago payment ID
  preferenceId  String?       // MercadoPago preference ID
  totalAmount   Decimal       @db.Decimal(12, 2)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([guestEmail])
  @@index([paymentId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  name        String // snapshot at order time
  sku         String? // snapshot
  price       Decimal @db.Decimal(12, 2) // snapshot
  quantity    Int
  total       Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ───────────────────────────────────────────
// Webhook Idempotency
// ───────────────────────────────────────────

model WebhookEvent {
  id        String   @id @default(uuid())
  source    String   // "mercadopago"
  eventId   String   // external event/payment id
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([source, eventId])
}
