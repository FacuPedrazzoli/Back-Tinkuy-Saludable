# =============================================================================
# env.example.dokploy — Back-Tinkuy-Saludable (Backend)
# =============================================================================
# NOTE: .env.example in this repo could not be overwritten (tool permission
# restriction on .env* filenames). This file serves the same purpose.
# Copy it to .env and fill in every value before running.
# Never commit .env to version control.
#
# DEV block  — values you can use as-is for local development with Docker.
# PROD block — guidance for what to set in the Dokploy environment panel.
# =============================================================================


# -----------------------------------------------------------------------------
# POSTGRES
# -----------------------------------------------------------------------------
# DEV:  use these defaults; docker compose creates the database automatically
# PROD: keep same var names; use a strong POSTGRES_PASSWORD
POSTGRES_USER=tinkuy
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=tinkuy
#
# DATABASE_URL is composed inside docker-compose.yml as:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
# Do not set DATABASE_URL here — it would conflict with compose interpolation.


# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# REDIS_URL is hardcoded in docker-compose.yml as redis://redis:6379.
# Override here only if pointing to an external Redis instance.
# REDIS_URL=redis://redis:6379


# -----------------------------------------------------------------------------
# AUTH — JWT secrets
# -----------------------------------------------------------------------------
# DEV:  any non-empty string works locally
# PROD: generate with: openssl rand -hex 64
JWT_ADMIN_SECRET=dev_jwt_admin_secret_change_in_prod
JWT_CUSTOMER_SECRET=dev_jwt_customer_secret_change_in_prod


# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------
# DEV:  any password
# PROD: strong password stored in a password manager
ADMIN_EMAIL=admin@tinkuy.com
ADMIN_PASSWORD=admin_dev_password


# -----------------------------------------------------------------------------
# CORS — Frontend public URL
# -----------------------------------------------------------------------------
# DEV:
FRONTEND_URL=http://localhost:3000
# PROD: FRONTEND_URL=https://tinkuy.com.ar


# -----------------------------------------------------------------------------
# MERCADOPAGO
# -----------------------------------------------------------------------------
# DEV:  test credentials from MP developer dashboard; MP_MODE=test enables sandbox
MP_MODE=test
MP_ACCESS_TOKEN=TEST-your-test-access-token
MP_PUBLIC_KEY=TEST-your-test-public-key
MP_WEBHOOK_SECRET=your_mp_webhook_secret
# DEV:  use ngrok or similar to receive webhook callbacks locally
MP_NOTIFICATION_URL=https://your-ngrok-url.ngrok.io/webhook/mercadopago
#
# PROD:
# MP_MODE=production
# MP_ACCESS_TOKEN=APP_USR-your-prod-access-token
# MP_PUBLIC_KEY=APP_USR-your-prod-public-key
# MP_NOTIFICATION_URL=https://api.tinkuy.com.ar/webhook/mercadopago


# -----------------------------------------------------------------------------
# EMAIL — Resend
# -----------------------------------------------------------------------------
# DEV:  Resend test key; delivered emails appear in the Resend dev dashboard
# PROD: production Resend API key
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=hola@tinkuy.com.ar
EMAIL_FROM_NAME=Tinkuy


# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
# UPLOAD_DIR is set to /app/uploads in docker-compose.yml (not overridable here).
MAX_FILE_SIZE_MB=5


# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# DEV:  leave empty to disable Sentry
# PROD: Sentry DSN from the Sentry project settings page
SENTRY_DSN=
LOG_LEVEL=info
# PROD: LOG_LEVEL=warn


# -----------------------------------------------------------------------------
# SEED
# -----------------------------------------------------------------------------
# Set to true ONLY to load demo/sample catalog data; leave unset for a clean DB.
# SEED_DEMO=true


# -----------------------------------------------------------------------------
# RATE LIMITING — defaults are set in docker-compose.yml
# -----------------------------------------------------------------------------
# Uncomment and adjust to override locally:
# RATE_LIMIT_GENERAL_WINDOW_MS=60000
# RATE_LIMIT_GENERAL_MAX_REQUESTS=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX_REQUESTS=5
# RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
# RATE_LIMIT_CHECKOUT_MAX_REQUESTS=10


# -----------------------------------------------------------------------------
# CACHE TTLs — defaults are set in docker-compose.yml
# -----------------------------------------------------------------------------
# CART_TTL_SECONDS=86400
# STOCK_TTL_SECONDS=300
