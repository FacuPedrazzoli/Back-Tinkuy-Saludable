# ===========================================
# Dockerfile - Cron (Scheduled Jobs)
# ===========================================
# Runs: abandoned cart reminders, cleanup jobs, backups metadata

FROM node:20-alpine AS runner
WORKDIR /app

# Security: Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 cron

# Set production environment
ENV NODE_ENV=production
ENV CRON_MODE=true

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs

# Copy package files and dependencies
COPY package.json package-lock.json* ./
RUN npm ci --only=production --ignore-scripts

# Copy Prisma client
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy source code
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/emails ./src/emails

# Install dumb-init for signal handling
RUN apk add --no-cache dumb-init

# Use non-root user
USER cron

# No port exposed - runs as cron

# Healthcheck - simple process check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD pgrep -x node || exit 1

CMD ["dumb-init", "node", "dist/cron.js"]
