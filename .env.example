# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/facusito?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (generate strong random strings - DO NOT USE THESE EXAMPLES IN PRODUCTION)
JWT_ADMIN_SECRET="EXAMPLE_admin_secret_change_me_min_32_chars"
JWT_CUSTOMER_SECRET="EXAMPLE_customer_secret_change_me_min_32_chars"

# MercadoPago
MP_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MP_WEBHOOK_SECRET="whsec_change_me"
MP_MODE="test" # Options: "test" or "production"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Trust Proxy (set to number of proxies, or "true" for single proxy)
# TRUST_PROXY=1

# Log Level (debug, info, warn, error, fatal)
# LOG_LEVEL=info

# Cache Configuration
STOCK_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX_REQUESTS=10
RATE_LIMIT_FALLBACK_MEMORY_LIMIT=10

# Cart Configuration
CART_TTL_SECONDS=86400
CART_LOCK_TTL_SECONDS=5
CART_LOCK_RETRY_COUNT=3
CART_LOCK_RETRY_DELAY_MS=100

# Webhook Configuration
WEBHOOK_TIMEOUT_MS=30000
