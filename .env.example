# ===========================================
# DATABASE (Supabase o PostgreSQL directo)
# ===========================================
DATABASE_URL=postgresql://user:password@host:5432/tinkuy

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# AUTH - JWT Secrets (minimo 32 caracteres)
# ===========================================
JWT_ADMIN_SECRET=change-me-to-a-secret-at-least-32-chars
JWT_CUSTOMER_SECRET=change-me-to-another-secret-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secret-32-chars

# ===========================================
# SEED - Admin credentials (used by prisma/seed.ts)
# Set these before running `npm run db:seed`.
# Fallbacks in the seed script are for local dev only; do not rely on them in prod.
# ===========================================
ADMIN_EMAIL=admin@tinkuy.com
ADMIN_PASSWORD=Admin123!

# ===========================================
# MERCADOPAGO
# ===========================================

# SANDBOX (desarrollo)
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_SANDBOX_INIT_POINT=https://sandbox.mercadopago.com/checkout/v2
MP_PRODUCTION_INIT_POINT=https://mercadopago.com/checkout/v2

# PRODUCCION — usar APP_USR- (NO TEST-)
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Webhook
MP_WEBHOOK_SECRET=your_webhook_secret_from_mp_dashboard
MP_NOTIFICATION_URL=https://tinkuy.com.ar/api/webhooks/mercadopago

# Modo: "test" | "production"
MP_MODE=test

# ===========================================
# EMAIL (SendGrid, Resend, etc.)
# ===========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@tinkuy.com.ar

# ===========================================
# RESEND (Email provider)
# ===========================================
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=hola@tinkuy.com.ar
EMAIL_FROM_NAME=Tinkuy

# ===========================================
# FRONTEND (para CORS y redirects)
# ===========================================
FRONTEND_URL=https://tinkuy.com.ar

# ===========================================
# SENTRY
# ===========================================
SENTRY_DSN=https://example@sentry.io/1234567
SENTRY_ORG=your-org
SENTRY_PROJECT=backend

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ===========================================
# GRAPHQL SECURITY
# ===========================================
GRAPHQL_INTROSPECTION=false

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
